<%# app/views/global_covid/index.html.erb %>



<!-- Purpose of file
This view renders a page showing 
the latest global COVID-19 statistics.
It uses data passed from 
the controller (@covid_data) and visualizes it
with a Plotly bar chart. 
The data comes from the disease.sh API.
-->



<% content_for :title, "Global COVID-19 Statistics" %>

<div class="container mt-5">


<!-- 1 -->
  <!-- Page Header and paragraph-->
  <h1 class="fw-bold text-primary text-center">Global COVID-19 Statistics</h1>
  
  <p class="text-muted fs-5 text-center mb-4">
    This page shows the latest global COVID-19 statistics using data from disease.sh API.
  </p>



<!-- 2 -->
  <!-- Graph Section -->
  <h2 class="mt-5 text-primary fw-semibold">Worldwide COVID-19 Overview</h2>


  <!-- If no data is available, show a warning -->
  <% if @covid_data.blank? %>
    <p class="alert alert-warning text-center">No data available at the moment.</p>

  <% else %>

    <!--
      Chart container that stores dataset inside HTML5 data-* attributes.
      This removes the need for ERB inside JavaScript.
    -->
    <div 
      id="globalCovidGraph"
      style="width:100%; height:600px;"
      data-cases="<%= @covid_data['cases'] || 0 %>"
      data-deaths="<%= @covid_data['deaths'] || 0 %>"
      data-recovered="<%= @covid_data['recovered'] || 0 %>"
      data-active="<%= @covid_data['active'] || 0 %>"
      data-critical="<%= @covid_data['critical'] || 0 %>"
      data-tests="<%= @covid_data['tests'] || 0 %>">
    </div>

    <!-- External JS that handles Plotly chart rendering -->
    <%= javascript_include_tag "global_covid_index", defer: true %>

  <% end %>



<!-- 4 -->
  <!-- Explanatory paragraph -->
  <p class="text-muted fs-6 mt-3">
    The chart above provides a quick overview of global COVID-19 numbers, including total cases, deaths, recoveries, active cases, critical cases, and total tests performed worldwide.
    Data is updated regularly via the disease.sh API.
  </p>


</div>
