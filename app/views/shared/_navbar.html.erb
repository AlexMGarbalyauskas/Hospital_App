
<!-- navbar at the top of the page 
this file gets rendered in layouts/application.html.erb
links to other views/ page files -->

<nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm sticky-top">
  <div class="container-fluid">
    


    <!-- Brand Title -->
    <%= link_to "Hospital Logs", root_path, class: "navbar-brand fw-bold text-primary" %>



    <!-- Mobile Toggle Button -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
  


    <!-- Navbar Links -->
    <div class="collapse navbar-collapse" id="navbarNav">
      


      <!-- Left Navigation -->
      <ul class="navbar-nav">
        <li class="nav-item">
          <%= link_to "Home", root_path, class: "nav-link #{'active' if current_page?(root_path)}" %>
        </li>
        <li class="nav-item">
          <%= link_to "About/Video", about_path, class: "nav-link #{'active' if current_page?(about_path)}" %>
        </li>
        <li class="nav-item">
         
        </li>
        <li class="nav-item">
          <%= link_to "GitHub-Repo-Link", "https://github.com/AlexMGarbalyauskas/Hospital_App", class: "nav-link", target: "_blank", rel: "noopener" %>
        </li>

      </ul>




      <!-- Right Navigation -->
      <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
        <% if Current.user %>
          <!-- User Dropdown -->
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="bi bi-person-circle me-1"></i><%= Current.user.email %>
            </a>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
              <li>
                <%= button_to "Logout", logout_path, method: :delete, class: "dropdown-item" %>
              </li>
            </ul>
          </li>
        <% else %>
          <li class="nav-item">
            <%= link_to "Sign Up", sign_up_path, class: "nav-link #{'active' if current_page?(sign_up_path)}" %>
          </li>
          <li class="nav-item">
            <%= link_to "Login", sign_in_path, class: "nav-link #{'active' if current_page?(sign_in_path)}" %>
          </li>
        <% end %>
      </ul>



    </div>
  </div>
</nav>
