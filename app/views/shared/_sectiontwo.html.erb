

<%# Nice, modern carousel with quotes at the bottom displayed
at the home index page fo gallert frontend 

uses images from assets/images folder, bootstarp is needed
for function linked in application.html.erb%>


<div class="container py-5 mt-5">

  <div id="hospitalCarousel"
       class="carousel slide carousel-fade shadow-lg rounded overflow-hidden"
       data-bs-ride="carousel"
       data-bs-interval="4000">

    <div class="carousel-inner" style="height: 400px;">



      <!-- Slide 1 -->
      <div class="carousel-item active position-relative h-100 bg-dark">
        <%= image_tag "photo1.jpg",
                      class: "d-block w-100 h-100",
                      style: "object-fit: contain; background-color: #000;",
                      alt: "Patient dashboard" %>
        <div class="carousel-caption position-absolute bottom-0 start-0 end-0 mb-0">
          <div class="bg-primary bg-opacity-90 py-3 px-4">
            <h5 class="fw-bold text-white text-center mb-0">
              "Healing is a matter of time, but it is sometimes also a matter of opportunity." — Hippocrates
            </h5>
          </div>
        </div>
      </div>




      <!-- Slide 2 -->
      <div class="carousel-item position-relative h-100 bg-dark">
        <%= image_tag "photo2.jpg",
                      class: "d-block w-100 h-100",
                      style: "object-fit: contain; background-color: #000;",
                      alt: "Medical team at work" %>
        <div class="carousel-caption position-absolute bottom-0 start-0 end-0 mb-0">
          <div class="bg-primary bg-opacity-90 py-3 px-4">
            <h5 class="fw-bold text-white text-center mb-0">
              "Wherever the art of medicine is loved, there is also a love of humanity." — Hippocrates
            </h5>
          </div>
        </div>
      </div>




      <!-- Slide 3 -->
      <div class="carousel-item position-relative h-100 bg-dark">
        <%= image_tag "photo3.jpg",
                      class: "d-block w-100 h-100",
                      style: "object-fit: contain; background-color: #000;",
                      alt: "Treatment timeline overview" %>
        <div class="carousel-caption position-absolute bottom-0 start-0 end-0 mb-0">
          <div class="bg-primary bg-opacity-90 py-3 px-4">
            <h5 class="fw-bold text-white text-center mb-0">
              "The greatest wealth is health." — Virgil
            </h5>
          </div>
        </div>
      </div>




      <!-- Slide 4 -->
      <div class="carousel-item position-relative h-100 bg-dark">
        <%= image_tag "photo4.jpg",
                      class: "d-block w-100 h-100",
                      style: "object-fit: contain; background-color: #000;",
                      alt: "Hospital care and healing" %>
        <div class="carousel-caption position-absolute bottom-0 start-0 end-0 mb-0">
          <div class="bg-primary bg-opacity-90 py-3 px-4">
            <h5 class="fw-bold text-white text-center mb-0">
              "Medicine is a science of uncertainty and an art of probability." — William Osler
            </h5>
          </div>
        </div>
      </div>

    </div>





    <!-- Navigation Controls -->
    <button class="carousel-control-prev" type="button" data-bs-target="#hospitalCarousel" data-bs-slide="prev">
      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#hospitalCarousel" data-bs-slide="next">
      <span class="carousel-control-next-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Next</span>
    </button>




    <!-- Carousel Indicators -->
    <div class="carousel-indicators mb-0">
      <button type="button" data-bs-target="#hospitalCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
      <button type="button" data-bs-target="#hospitalCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
      <button type="button" data-bs-target="#hospitalCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
      <button type="button" data-bs-target="#hospitalCarousel" data-bs-slide-to="3" aria-label="Slide 4"></button>
    </div>
  </div>
</div>
