<!-- map/api_page.html.erb -->

<!-- used to display the covid vaccine data and map
to users to see how many countries are vaccinated 
API -->

<h1 class="fw-bold text-primary text-center mt-5">Vaccine Map API</h1>
<p class="text-muted fs-5 text-center mb-4">
  This page demonstrates the backend RESTful API for the Hospital App.
</p>

<h2 class="mt-5 text-primary fw-semibold">COVID-19 Vaccination Coverage</h2>

<% if @vaccine_map.blank? %>
  <p class="alert alert-warning">No vaccination data available.</p>
<% end %>

<!-- Map + overlay button wrapper -->
<div class="position-relative my-3" style="min-height:520px;">

  <!-- gmp web component map (attach vaccine JSON for plotting) -->
  <gmp-map id="gmpMap"
           style="display:block; height:500px; width:100%;"
           center="20,0"
           zoom="2"
           data-vaccine-data="<%= json_escape(@vaccine_map.to_json) %>">
  </gmp-map>

  <!-- advanced marker + hidden place picker -->
  <gmp-advanced-marker id="gmpMarker"></gmp-advanced-marker>
  <gmpx-place-picker id="gmpPlacePicker" style="display:none;"></gmpx-place-picker>

  <!-- floating button -->
  <button type="button"
          class="btn btn-primary position-absolute bottom-0 end-0 m-3 shadow-sm"
          style="z-index:1100;"
          data-bs-toggle="modal"
          data-bs-target="#vaccineModal">
    <i class="bi bi-table me-1"></i> View data table
  </button>

</div>

<!-- Modal with vaccine table -->
<div class="modal fade" id="vaccineModal" tabindex="-1"
     aria-labelledby="vaccineModalLabel" aria-hidden="true">

  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title text-primary fw-semibold" id="vaccineModalLabel">
          Vaccination coverage — table
        </h5>
        <button class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">

        <% if @vaccine_map.present? %>
          <div class="table-responsive">
            <table class="table table-sm table-striped table-bordered mb-0">
              <thead class="table-light">
                <tr>
                  <th>Country</th>
                  <th class="text-end">Total doses</th>
                </tr>
              </thead>
              <tbody>
                <% @vaccine_map.each do |country, coverage| %>
                  <tr>
                    <td><%= country %></td>
                    <td class="text-end"><%= number_with_delimiter(coverage) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="text-muted">No data available.</p>
        <% end %>

      </div>

      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>

    </div>
  </div>
</div>

<!-- External JS -->
<%= javascript_include_tag "vaccine_map", defer: true %>

<!-- Google Maps loader -->
<script async defer
  src="https://maps.googleapis.com/maps/api/js?key=AIzaSyCydU2EJkqDCI32gKWRyfEJEpX9MFsknP8&v=weekly&libraries=places&callback=initVaccineMap">
</script>
