<% content_for :title, "Patient Details" %>

<div class="container pt-5 d-flex justify-content-center">
  <%# Determine initial card class based on treatment status %>
  <% card_class = case @patient.treatment_status
       when "treated" then "bg-success text-white"
       when "dead" then "bg-dark text-white"
       else ""
     end %>

  <% critical_badge = case @patient.critical_status
       when "Critical" then "bg-danger text-white"
       when "Non Critical" then "bg-orange"
       when "Mild" then "bg-warning text-dark"
       else "bg-secondary text-white"
     end %>

  <div id="patient-card-<%= @patient.id %>" class="card shadow-sm w-100 <%= card_class %>" style="max-width: 600px;">
    
    <div id="patient-header-<%= @patient.id %>" class="card-header <%= card_class.blank? ? 'bg-info text-white' : '' %> p-0">
      <div class="d-flex align-items-center">
        <div class="p-3">
          <% if @patient.photo.attached? %>
            <%= image_tag @patient.photo.variant(resize_to_limit: [80, 80]), class: "rounded-circle border" %>
          <% else %>
            <%= image_tag "user.png", class: "rounded-circle border", width: 80, height: 80 %>
          <% end %>
        </div>
        <div class="flex-grow-1 d-flex align-items-center ps-3">
          <h4 class="mb-0" id="patient-title-<%= @patient.id %>">
            <% if @patient.treatment_status == "treated" %>
              Treated
            <% elsif @patient.treatment_status == "dead" %>
              Dead
            <% else %>
              Patient Details
            <% end %>
          </h4>
        </div>
      </div>
    </div>

    <div id="patient-body-<%= @patient.id %>" class="card-body <%= card_class %>">
      <p><strong>Name:</strong> <%= @patient.name.presence || "Not recorded" %></p>
      <p><strong>Age:</strong> <%= @patient.age.presence || "Not recorded" %></p>
      <p><strong>Diagnosis:</strong> <%= @patient.diagnosis.presence || "Not recorded" %></p>
      <p><strong>Admitted on:</strong> <%= @patient.admitted_on.present? ? @patient.admitted_on.strftime("%B %d, %Y") : "Not recorded" %></p>
      <hr>
      <p><strong>Age Group:</strong> <%= @patient.category.presence || "Not set" %></p>
      <p>
        <strong>Critical Status:</strong>
        <span class="badge <%= critical_badge %> px-2 py-1"><%= @patient.critical_status.presence || "Not set" %></span>
      </p>
      <p><strong>Treatment Time:</strong> <%= @patient.treatment_time.presence || "Not set" %></p>
      <p><strong>Treatment Status:</strong> <span id="patient-status-<%= @patient.id %>"><%= @patient.treatment_status.presence || "Not Treated" %></span></p>

      <!-- Dropdown to change treatment status dynamically -->
      <div class="mt-3">
        <label for="treatment-status-select" class="form-label">Update Treatment Status:</label>
        <select id="treatment-status-select" class="form-select" data-patient-id="<%= @patient.id %>">
          <option value="not_treated" <%= @patient.treatment_status.blank? ? "selected" : "" %>>Not Treated</option>
          <option value="treated" <%= @patient.treatment_status == "treated" ? "selected" : "" %>>Treated</option>
          <option value="dead" <%= @patient.treatment_status == "dead" ? "selected" : "" %>>Dead</option>
        </select>
      </div>
    </div>
  </div>
</div>

<div class="container mt-4 d-flex justify-content-center gap-3 flex-wrap">
  <%= link_to "← Back to Patients", patients_path, class: "btn btn-outline-secondary btn-sm" %>
  <%= link_to "Edit", edit_patient_path(@patient), class: "btn btn-outline-primary btn-sm" %>
  <%= button_to "Delete", @patient, method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-outline-danger btn-sm" %>
</div>

<%= javascript_tag do %>
document.addEventListener("DOMContentLoaded", function() {
  const select = document.getElementById("treatment-status-select");
  const patientId = select.dataset.patientId;
  const card = document.getElementById(`patient-card-${patientId}`);
  const header = document.getElementById(`patient-header-${patientId}`);
  const body = document.getElementById(`patient-body-${patientId}`);
  const title = document.getElementById(`patient-title-${patientId}`);
  const statusText = document.getElementById(`patient-status-${patientId}`);

  select.addEventListener("change", function() {
    const status = select.value;

    // Remove previous classes
    card.classList.remove("bg-success", "bg-dark", "text-white");
    header.classList.remove("bg-success", "bg-dark", "text-white", "bg-info");
    body.classList.remove("bg-success", "bg-dark", "text-white");

    // Apply new classes and update text
    if (status === "treated") {
      card.classList.add("bg-success", "text-white");
      header.classList.add("bg-success", "text-white");
      body.classList.add("bg-success", "text-white");
      title.innerText = "Treated";
      statusText.innerText = "Treated";
    } else if (status === "dead") {
      card.classList.add("bg-dark", "text-white");
      header.classList.add("bg-dark", "text-white");
      body.classList.add("bg-dark", "text-white");
      title.innerText = "Dead";
      statusText.innerText = "Dead";
    } else {
      header.classList.add("bg-info", "text-white");
      title.innerText = "Patient Details";
      statusText.innerText = "Not Treated";
    }

    // Optional: send AJAX PATCH to update DB
    fetch(`/patients/${patientId}`, {
      method: "PATCH",
      headers: {
        "Content-Type": "application/json",
        "X-CSRF-Token": document.querySelector("[name='csrf-token']").content
      },
      body: JSON.stringify({ patient: { treatment_status: status } })
    });
  });
});
<% end %>
