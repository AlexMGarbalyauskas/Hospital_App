<!-- views/patients/show.html.erb --> 

<!-- This file is for displaying patient data 
includes a button to check out the API used appears as a
modal pop up screen with 3 APIs to view for 
doctor info -->

<!-- JS link from assets/javascripts/show_patient_form.js -->
<%= javascript_include_tag "show_patient_form", defer: true %>

<% content_for :title, "Patient Details" %>

<div class="container mt-5">
  <div class="card shadow rounded-4 p-0" style="max-width: 900px; width: 100%;">
    <div class="row g-0">

      <!-- Left Side: Patient Info & Actions -->
      <div class="col-md-4 <%= @patient.treatment_status == "Dead" ? "bg-black text-white" : @patient.treatment_status == "Cured" ? "bg-success text-white" : "bg-dark text-white" %> d-flex flex-column align-items-center justify-content-center p-4">
        <h2 class="fw-bold text-center mb-3">
          <%= @patient.treatment_status == "Dead" ? "☠️ Deceased Patient" : @patient.treatment_status == "Cured" ? "✅ Cured Patient" : "Patient Details" %>
        </h2>

        <!-- profile pic -->
        <% if @patient.profile_pic.attached? %>
          <%= image_tag @patient.profile_pic, class: "img-thumbnail", style: "width: 180px;" %>
        <% else %>
          <%= image_tag "user.png", class: "img-thumbnail", style: "width: 180px;" %>
        <% end %>

        <!-- btns to go back to index, edit, delete and api -->
        <div class="d-flex flex-column gap-2 mt-4 w-100">
          <%= link_to "↩️ Back", patients_path, class: "btn btn-outline-light w-100" %>
          <%= link_to "✏️ Edit", edit_patient_path(@patient), class: "btn btn-outline-warning w-100" %>
          <%= button_to patient_path(@patient), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-outline-danger w-100" do %>
            🗑 Delete
          <% end %>
          <%= button_tag "Check Current Covid-19 Data", class: "btn btn-outline-primary w-100", data: { bs_toggle: "modal", bs_target: "#apiOptionsModal" } %>
        </div>
      </div>

      <!-- Right Side: Detailed Patient Data -->
      <div class="col-md-8 p-4">
        <ul class="list-group list-group-flush mb-3">
          <li class="list-group-item"><strong>Name:</strong> <%= @patient.name %></li>
          <li class="list-group-item"><strong>Age:</strong> <%= @patient.age %> (<%= @patient.age_group %>)</li>
          <li class="list-group-item"><strong>Gender:</strong> <%= @patient.gender %></li>
          <li class="list-group-item"><strong>Vaccinated:</strong> <%= @patient.vaccinated ? "Yes" : "No" %></li>
          <li class="list-group-item"><strong>Diagnosis:</strong> <%= @patient.diagnosis %></li>

          <% badge_class, icon = case @patient.critical_status
            when "Mild" then ["bg-warning text-dark", nil]
            when "Critical" then ["bg-orange text-white", "⚠️"]
            when "Highly Critical" then ["bg-danger text-white", "⚠️"]
            when "Immediate" then ["bg-danger text-white", "⚠️"]
            else ["bg-secondary text-white", nil]
          end %>

          <li class="list-group-item">
            <strong>Critical Status:</strong>
            <span class="badge <%= badge_class %> px-2 py-1">
              <%= icon %> <%= @patient.critical_status %>
            </span>
          </li>

          <li class="list-group-item"><strong>Treatment Status:</strong> <%= @patient.treatment_status %></li>

          <% if @patient.treatment_status == "Dead" %>
            <li class="list-group-item"><strong>Date of Death:</strong> <%= @patient.date_of_death %></li>
            <li class="list-group-item"><strong>Reason of Death:</strong> <%= @patient.reason_of_death %></li>
          <% elsif @patient.treatment_status == "Cured" %>
            <li class="list-group-item"><strong>Date of Cure:</strong> <%= @patient.treatment_date %></li>
            <li class="list-group-item"><strong>Reason for Cure:</strong> <%= @patient.treatment_reason %></li>
          <% end %>

          <li class="list-group-item"><strong>Living Status:</strong> <%= @patient.living_status %></li>
          <li class="list-group-item"><strong>Profile Picture Attached:</strong> <%= @patient.profile_pic.attached? ? "Yes" : "No" %></li>
        </ul>
      </div>
    </div>
  </div>
</div>

<!-- Modal for API Options  
a pop up after view data btn is clicked to check out
all the api that is used -->
<div class="modal fade" id="apiOptionsModal" tabindex="-1" aria-labelledby="apiOptionsModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">

      <!-- Header -->
      <div class="modal-header">
        <h5 class="modal-title" id="apiOptionsModalLabel">API Options</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <!-- Body -->
      <div class="modal-body">

        <!-- API Option Buttons -->
        <div class="d-flex gap-2 mb-3">
          <button class="btn btn-primary" id="btnShowMap">🗺 Map API</button>
          <button class="btn btn-info" id="btnShowCovid">📊 COVID Historical API</button>
          <button class="btn btn-success" id="btnShowGlobalCovid">🌍 Global COVID API</button>
        </div>

        <!-- Container for dynamic API content -->
        <div id="apiContent"
             data-map-api="<%= map_api_path %>"
             data-covid-api="<%= api_page_path %>"
             data-global-covid-api="<%= global_covid_path %>"
             style="min-height:600px; width:100%; display:flex; justify-content:center; align-items:center;">
          <p class="text-muted text-center">Select an API option to view content</p>
        </div>

      </div>

      <!-- Footer -->
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>

    </div>
  </div>
</div>
