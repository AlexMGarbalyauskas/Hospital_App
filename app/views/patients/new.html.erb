<div class="container mt-5">
  <div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
      <h4 class="mb-0">Add New Patient</h4>
    </div>
    <div class="card-body">
      <%= form_with model: @patient, local: true do |f| %>
        <div class="mb-3">
          <%= f.label :name, class: "form-label" %>
          <%= f.text_field :name, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :age, class: "form-label" %>
          <%= f.number_field :age, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :diagnosis, class: "form-label" %>
          <%= f.text_area :diagnosis, class: "form-control", rows: 3 %>
        </div>

        <div class="mb-3">
          <%= f.label :admitted_on, class: "form-label" %>
          <%= f.date_field :admitted_on, class: "form-control" %>
        </div>

        <%= f.submit "Create Patient", class: "btn btn-success" %>
      <% end %>
    </div>
  </div>
</div>
