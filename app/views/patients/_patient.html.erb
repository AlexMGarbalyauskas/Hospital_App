<div id="<%= dom_id patient %>">
  <p>
    <strong>Name:</strong>
    <%= patient.name %>
  </p>

  <p>
    <strong>Age:</strong>
    <%= patient.age %>
  </p>

  <p>
    <strong>Diagnosis:</strong>
    <%= patient.diagnosis %>
  </p>

  <p>
    <strong>Category:</strong>
    <%= patient.category %>
  </p>

  <p>
    <strong>Addmitted on:</strong>
    <%= patient.addmitted_on %>
  </p>

  <p>
    <strong>Age group:</strong>
    <%= patient.age_group %>
  </p>

  <p>
    <strong>Critical status:</strong>
    <%= patient.critical_status %>
  </p>

  <p>
    <strong>Profile pic:</strong>
    <%= patient.profile_pic %>
  </p>

</div>
