<div class="container mt-5">
  <h2>Medications Lookup for <%= @patient.name %></h2>

  <%= form_with url: fetch_medications_patient_path(@patient), method: :get, local: true, class: "mb-3" do |f| %>
    <div class="input-group">
      <%= f.text_field :keyword, placeholder: "Search for medication...", class: "form-control", value: params[:keyword] %>
      <%= f.hidden_field :type, value: "dur" %> <%# change to "medications" if you want the normal lookup %>
      <button class="btn btn-primary" type="submit">Search</button>
    </div>
  <% end %>

  <% if @medications.present? %>
    <ul class="list-group mt-3">
      <% @medications.each do |med| %>
        <li class="list-group-item"><%= med %></li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-muted mt-3">No results found. Try another keyword.</p>
  <% end %>
</div>
