<% content_for :title, "Patients" %>

<div class="container mt-4">
  <!-- Top bar: New Patient + Search + Filters -->
  <div class="d-flex flex-wrap align-items-center gap-3 w-100 mb-3">
    <%= link_to "New Patient", select_patient_category_path, class: "btn btn-success btn-sm px-4" %>

    <div class="flex-grow-1">
      <%= form_with url: patients_path, method: :get, local: true, class: "d-flex gap-2 align-items-center", id: "filter-form" do %>
        <%= text_field_tag "q[name_or_diagnosis_cont]",
              params.dig(:q, :name_or_diagnosis_cont),
              placeholder: "Search by name or diagnosis",
              class: "form-control form-control-sm",
              style: "min-width: 300px; max-width: 500px;" %>

        <%= submit_tag "Search", class: "btn btn-outline-primary btn-sm" %>

        <%= select_tag :category_type,
          options_for_select([["Search by category", ""], "Age Group", "Critical Status", "Treatment Time"], params[:category_type]),
          class: "form-select form-select-sm",
          id: "category-type",
          style: "color: #6c757d;" %>

        <%= select_tag :category_value,
              options_for_select([ "Child", "Adult", "Senior", "Critical", "Non Critical", "Mild", "Immediate", "Scheduled", "Routine"], params[:category_value]),
              class: "form-select form-select-sm d-none", id: "category-value" %>

        <%= link_to "Clear", patients_path, class: "btn btn-outline-secondary btn-sm" %>
      <% end %>
    </div>
  </div>

  <% if params[:category_type].present? && params[:category_value].present? %>
    <div class="alert alert-info d-flex justify-content-between align-items-center">
      <div>
        Showing patients with
        <strong><%= params[:category_type] %></strong> =
        <strong><%= params[:category_value] %></strong>
      </div>
      <%= link_to "Clear Filter", patients_path, class: "btn btn-sm btn-outline-secondary" %>
    </div>
  <% end %>

  <!-- Patients cards -->
  <div id="patients" class="row mt-3" style="display: flex; flex-wrap: wrap;">
    <% if @patients.any? %>
      <% @patients.each do |patient| %>

        <%# Card color based on treatment status %>
        <% card_class = case patient.treatment_status
             when "treated" then "bg-success text-white"
             when "dead" then "bg-dark text-white"
             else ""
           end %>

        <%# Badge class for Critical Status %>
        <% critical_badge = case patient.critical_status
             when "Critical" then "bg-danger text-white"
             when "Non Critical" then "bg-orange text-white"
             when "Mild" then "bg-warning text-dark"
             else "bg-secondary text-white"
           end %>

        <div id="patient-<%= patient.id %>" class="col-md-4 mb-4 patient-card" draggable="true" data-patient-id="<%= patient.id %>" ondragstart="dragStart(event)" ondragover="dragOver(event)" ondrop="drop(event)">
          <div class="card shadow-sm <%= card_class %>">
            <div class="card-header <%= patient.treatment_status.in?(["treated","dead"]) ? "" : "bg-info" %> text-white text-center">
              <h5 class="mb-0">
                <% if patient.treatment_status == "treated" %>
                  Treated
                <% elsif patient.treatment_status == "dead" %>
                  Dead
                <% else %>
                  Patient Details
                <% end %>
              </h5>
            </div>

            <div class="card-body text-start">
              <div class="mb-3 text-center">
                <% if patient.photo.attached? %>
                  <%= image_tag patient.photo.variant(resize_to_limit: [80, 80]), class: "rounded-circle border", alt: "Patient photo" %>
                <% else %>
                  <%= image_tag "user.png", class: "rounded-circle border", width: 80, height: 80, alt: "Default photo" %>
                <% end %>
              </div>

              <p><strong>Name:</strong> <%= patient.name.presence || "Not recorded" %></p>
              <p><strong>Age:</strong> <%= patient.age.presence || "Not recorded" %></p>
              <p><strong>Diagnosis:</strong> <%= patient.diagnosis.presence || "Not recorded" %></p>
              <p><strong>Admitted on:</strong>
                <%= patient.admitted_on.present? ? patient.admitted_on.strftime("%B %d, %Y") : "Not recorded" %>
              </p>
              <hr>
              <p><strong>Age Group:</strong> <%= patient.category.presence || "Not set" %></p>
              <p>
                <strong>Critical Status:</strong>
                <span class="badge <%= critical_badge %> px-2 py-1"><%= patient.critical_status.presence || "Not set" %></span>
              </p>
              <p><strong>Treatment Time:</strong> <%= patient.treatment_time.presence || "Not set" %></p>

              <!-- Buttons: Show -->
              <div class="d-flex justify-content-center align-items-center gap-2 mt-3">
                <%= link_to "Show", patient_path(patient), class: "btn btn-outline-primary btn-sm" %>
              </div>
            </div>
          </div>
        </div>

      <% end %>
    <% else %>
      <p class="text-muted text-center">No patients found.</p>
    <% end %>
  </div>
</div>

<%= javascript_tag do %>
document.addEventListener("DOMContentLoaded", function() {
  let draggedElement = null;

  // Function to handle the drag start
  function dragStart(event) {
    draggedElement = event.target;
    event.dataTransfer.setData("text", draggedElement.id);  // Store dragged item ID
  }

  // Function to handle when an item is dropped
  function drop(event) {
    event.preventDefault();
    
    const target = event.target.closest(".col-md-4");  // Ensure the drop target is a patient card
    if (target && target !== draggedElement) {
      // Swap positions of dragged and target elements
      const parent = target.parentNode;
      parent.insertBefore(draggedElement, target.nextSibling);  // Insert after the target
    }
  }

  // Function to allow dragging over the target
  function dragOver(event) {
    event.preventDefault();  // Allow the drop
  }

  // Attach drag and drop functionality to all patient cards
  const patientCards = document.querySelectorAll(".patient-card");
  
  patientCards.forEach(card => {
    card.setAttribute("draggable", "true");  // Make each card draggable
    card.addEventListener("dragstart", dragStart);  // Add the drag start event
  });

  // Allow cards to be dropped
  const patientsContainer = document.getElementById("patients");
  patientsContainer.addEventListener("dragover", dragOver);  // Allow the drop
  patientsContainer.addEventListener("drop", drop);  // Handle the drop

  // Category filtering logic (unchanged)
  const typeSelect = document.getElementById("category-type");
  const valueSelect = document.getElementById("category-value");
  const form = document.getElementById("filter-form");

  const optionsMap = {
    "Age Group": ["Child", "Adult", "Senior"],
    "Critical Status": ["Critical", "Non Critical", "Mild"],
    "Treatment Time": ["Immediate", "Scheduled", "Routine"]
  };

  typeSelect.addEventListener("change", function () {
    const selectedType = typeSelect.value;
    const options = optionsMap[selectedType] || [];

    if (options.length > 0) {
      valueSelect.innerHTML = `<option value="">Select ${selectedType}</option>` +
        options.map(opt => `<option value="${opt}">${opt}</option>`).join("");
      valueSelect.classList.remove("d-none");
    } else {
      valueSelect.innerHTML = "";
      valueSelect.classList.add("d-none");
    }
  });

  valueSelect.addEventListener("change", function () {
    if (valueSelect.value !== "") {
      form.submit();
    }
  });
});
<% end %>
