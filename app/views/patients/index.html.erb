<div class="mb-4">
  <h1 class="display-5 fw-bold text-primary">Patient Management</h1>
  <p class="lead text-muted">Search, view, and manage all registered patients in the system.</p>
</div>

<div class="row align-items-end mb-4">
  <div class="col-md-9">
    <%= form_with url: patients_path, method: :get, local: true, class: "input-group" do %>
      <%= text_field_tag :query, params[:query], class: "form-control", placeholder: "Search by name, age, diagnosis, critical or treatment status..." %>
      <button class="btn btn-primary" type="submit">Search</button>
    <% end %>
  </div>
  <div class="col-md-3 text-md-start mt-3 mt-md-0">
    <%= link_to "Create New Patient", new_patient_path, class: "btn btn-success w-100" %>
  </div>
</div>

<div class="row">
  <% @patients.each_slice(3) do |group| %>
    <div class="row mb-4">
      <% group.each do |patient| %>
        <div class="col-md-4">
          <div class="card h-100 shadow-sm">
            <% if patient.profile_pic.attached? %>
              <%= image_tag patient.profile_pic, class: "card-img-top", style: "height: 200px; object-fit: cover;" %>
            <% end %>
            <div class="card-body">
              <h5 class="card-title"><%= patient.name %></h5>
              <p class="card-text">
                <strong>Age:</strong> <%= patient.age %> (<%= patient.age_group %>)<br>
                <strong>Diagnosis:</strong> <%= patient.diagnosis %><br>
                <strong>Critical:</strong> <%= patient.critical_status %><br>
                <strong>Treatment:</strong> <%= patient.treatment_status %>
              </p>
              <div class="d-flex justify-content-between">
                <%= link_to "Show", patient_path(patient), class: "btn btn-outline-primary btn-sm" %>
                <%= link_to "Edit", edit_patient_path(patient), class: "btn btn-outline-secondary btn-sm" %>
                <%= link_to "Delete", patient_path(patient), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-outline-danger btn-sm" %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
