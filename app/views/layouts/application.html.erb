<!DOCTYPE html>
<html>



  <head>
    <title><%= content_for(:title) || "Hospital App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>


    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">

    <!-- Optional JS libraries -->
    <script src="https://cdn.plot.ly/plotly-latest.min.js"></script>

    <!-- Main stylesheet -->
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <%= yield :head %>

    <!-- Favicon -->
    <%= favicon_link_tag asset_path('logo.png'), rel: "icon", type: "image/png" %>
    <%= favicon_link_tag asset_path('logo.png'), rel: "apple-touch-icon" %>
  </head>




<!-- body --> 


<!-- renders the navbar, flash and footer --> 
  <body class="d-flex flex-column min-vh-100">
    <%= render "shared/navbar" %>



    <main class="flex-grow-1 pb-5">
      <%= render "shared/flash" %>
      <div class="container mt-4">
        <%= yield %>
      </div>
    </main>


    <footer class="mt-5">
      <%= render "shared/footer" %>
    </footer>



    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>




    <!-- Flash auto-dismiss -->
    <script>
      setTimeout(() => {
        document.querySelectorAll('.flash-circle').forEach(el => {
          el.style.opacity = '0';
          setTimeout(() => el.remove(), 500);
        });
      }, 5000);
    </script>

  </body>



</html>
