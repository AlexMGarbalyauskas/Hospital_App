<!-- app/views/layouts/iframe.html.erb -->

<!DOCTYPE html>
<html>



<head>
  <title><%= content_for?(:title) ? yield(:title) : "Hospital App" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload", media: "all" %>

   <!-- Bootstrap CSS & JS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous" defer></script>
</head>



<body style="margin:0; padding:0;">
  <%= yield %>
</body>


</html>
